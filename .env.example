# cmd-remote configuration
# Copy this file to .env and edit values. Never commit .env.
#
# REQUIRED: a secret token that gates access to your PC's agent.
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CMD_REMOTE_TOKEN=change-me

# Optional: Tailscale MagicDNS hostname for HTTPS. Run `node tls-setup.mjs`
# once to fetch a free TLS cert; the script prints the hostname to set here.
# TAILSCALE_HOST=desktop-xxxx.tailXXXXX.ts.net

# Ports (defaults)
# PORT=8787
# TTY_PORT=8788
# HOST=0.0.0.0

# Working directory the agent operates in (default: where the server starts)
# WORK_DIR=C:\Users\You
